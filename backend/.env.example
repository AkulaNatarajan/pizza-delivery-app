# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/pizza-delivery

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Email Configuration (Gmail/NodeMailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=noreply@pizzadelivery.com

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_SECRET_KEY=your_razorpay_test_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Admin Configuration
ADMIN_EMAIL=admin@pizzadelivery.com
STOCK_THRESHOLD=20

# Frontend
FRONTEND_URL=http://localhost:3000
